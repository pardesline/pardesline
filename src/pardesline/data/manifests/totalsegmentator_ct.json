{
  "schema_version": 1,
  "name": "totalsegmentator_ct",
  "title": "TotalSegmentator CT dataset v2.0.1: 1 228 CT volumes with 117 anatomical structures",
  "description": "1 228 CT examinations from the University Hospital Basel with 117 structures segmented (organs, vessels, bones, muscles) as one binary mask per structure - the data behind the TotalSegmentator model. Read subject by subject out of the 23.6 GB zip on Zenodo (HTTP Range: the 144 905-entry central directory costs 14 MB once, a CT a few MB). meta.csv at the archive root gives age, gender, institute and split.",
  "source": {
    "scheme": "archive",
    "url": "https://zenodo.org/records/10047292/files/Totalsegmentator_dataset_v201.zip",
    "format": "zip"
  },
  "license": {
    "spdx": "CC-BY-4.0",
    "commercial": true,
    "source_url": "https://zenodo.org/records/10047292",
    "redistribution": "allowed",
    "note": "CC BY 4.0 on the Zenodo record (checked 2026-10-14). The TotalSegmentator model weights are a separate work under their own (non-commercial) terms."
  },
  "citation": "Wasserthal J., Breit H.-C., Meyer M.T., et al. TotalSegmentator: Robust Segmentation of 104 Anatomic Structures in CT Images. Radiology: AI 5(5), 2023.",
